{
 "_about": "NPC characteristics, as data. Add a trait by adding an entry; nothing else changes (each trait draws from its own seeded stream: hash(seed, person, trait id)). Schema in npc_traits.md. Validate and preview: python3 tools/charref/traits.py",

 "schema_version": 1,

 "tables": {
  "occupations": {
   "_cols":              ["weight", "sector", "income", "hours", "outfit", "age_min", "age_max", "caricature", "wage"],
   "retired":            [14, "none", "low", "home", "retired", 62, 99, 0.35, 24000],
   "preschool":          [6, "home", "none", "home", "child", 0, 5, 0.05, 0],
   "student":            [16, "school", "none", "school", "school", 6, 18, 0.1, 0],
   "homemaker":          [5, "home", "none", "home", "casual", 20, 80, 0.2, 0],
   "factory_hand":       [9, "manufacture", "mid", "shift", "workwear", 18, 64, 0.25, 44000],
   "nurse":              [5, "health", "mid", "shift", "scrubs", 22, 64, 0.15, 93000],
   "care_aide":          [4, "health", "low", "shift", "scrubs", 18, 64, 0.2, 34000],
   "shop_clerk":         [6, "retail", "low", "day", "apron", 16, 70, 0.2, 34000],
   "shopkeeper":         [3, "retail", "mid", "day", "apron", 28, 80, 0.4, 58000],
   "baker":              [1, "food", "low", "early", "baker", 18, 75, 0.35, 36000],
   "cook":               [3, "food", "low", "evening", "kitchen", 18, 70, 0.3, 36000],
   "waiter":             [3, "food", "low", "evening", "server", 16, 60, 0.15, 33000],
   "fisher":             [1, "water", "low", "early", "oilskins", 16, 80, 0.45, 38000],
   "dock_worker":        [2, "water", "mid", "shift", "workwear", 18, 64, 0.35, 52000],
   "farmer":             [2, "farm", "mid", "early", "farm", 16, 85, 0.4, 83000],
   "mechanic":           [2, "trade", "mid", "day", "coveralls", 17, 70, 0.3, 49000],
   "builder":            [3, "trade", "mid", "early", "workwear", 17, 65, 0.3, 52000],
   "teacher":            [3, "school", "mid", "school", "office", 23, 67, 0.2, 65000],
   "clerk":              [4, "office", "mid", "day", "office", 20, 67, 0.15, 43000],
   "police":             [1, "public", "mid", "shift", "police", 21, 60, 0.25, 75000],
   "postal_worker":      [1, "public", "mid", "early", "postal", 18, 65, 0.25, 55000],
   "driver":             [2, "transport", "mid", "shift", "workwear", 21, 70, 0.3, 56000],
   "doctor":             [0.5, "health", "high", "day", "office", 28, 75, 0.2, 240000],
   "pastor":             [0.3, "faith", "low", "day", "clergy", 28, 85, 0.4, 58000],
   "unemployed":         [4, "none", "none", "home", "casual", 18, 64, 0.25, 9000],
   "university_student": [0.5, "school", "none", "school", "casual", 18, 26, 0.1, 8000],
   "bartender":          [1.5, "food", "low", "evening", "server", 21, 70, 0.35, 35000],
   "barber":             [1, "service", "low", "day", "apron", 18, 80, 0.35, 38000],
   "banker":             [1.2, "office", "high", "day", "office", 24, 70, 0.2, 82000],
   "librarian":          [0.4, "public", "mid", "day", "office", 23, 75, 0.25, 64000],
   "lawyer":             [0.8, "office", "high", "day", "office", 25, 80, 0.25, 145000],
   "agent":              [1.5, "office", "mid", "day", "office", 21, 75, 0.2, 58000],
   "pharmacist":         [0.5, "health", "high", "day", "scrubs", 25, 70, 0.15, 136000],
   "hotel_worker":       [2, "service", "low", "shift", "server", 18, 70, 0.2, 32000],
   "janitor":            [3, "service", "low", "evening", "coveralls", 18, 75, 0.25, 36000],
   "editor":             [0.3, "office", "mid", "day", "office", 22, 80, 0.3, 58000],
   "firefighter":        [0.5, "public", "mid", "shift", "workwear", 21, 60, 0.25, 57000],
   "farmhand":           [2, "farm", "low", "early", "farm", 16, 70, 0.3, 36000],
   "dentist":            [0.3, "health", "high", "day", "scrubs", 27, 72, 0.15, 170000]
  },
  "palettes": {
   "_note":  "Named palette families; colours are (hue deg, sat 0-1, value 0-1). Sat mostly 0.15-0.45 per ghibli_style.md 2.2.",
   "earth":  [[30, 0.35, 0.45], [25, 0.3, 0.6], [40, 0.25, 0.7], [15, 0.4, 0.35], [55, 0.3, 0.55]],
   "sea":    [[205, 0.35, 0.45], [195, 0.25, 0.65], [215, 0.45, 0.3], [180, 0.2, 0.7], [40, 0.15, 0.8]],
   "meadow": [[95, 0.3, 0.5], [70, 0.35, 0.6], [110, 0.25, 0.4], [45, 0.4, 0.7], [20, 0.3, 0.5]],
   "dusk":   [[260, 0.2, 0.4], [330, 0.25, 0.55], [220, 0.3, 0.35], [20, 0.35, 0.65], [280, 0.15, 0.7]],
   "work":   [[210, 0.4, 0.35], [30, 0.25, 0.4], [0, 0.0, 0.3], [40, 0.45, 0.55], [200, 0.2, 0.55]],
   "accent": [[5, 0.7, 0.7], [48, 0.7, 0.85], [200, 0.6, 0.65], [340, 0.55, 0.75], [120, 0.55, 0.55]]
  }
 },

 "populations": {
  "_about": "Per-settlement context (research/demographics/_demographic_archetypes.md). 'override' replaces a trait's chooser; 'table_mul' multiplies table weights by row name or by 'col:value'. Pass the town's archetype as context; with none, the defaults above apply (they are the Stable Town).",
  "stable_town": {"override": {"age": {"bands": [[0, 5, 6], [6, 17, 17], [18, 29, 13], [30, 44, 17], [45, 64, 25], [65, 84, 19], [85, 99, 3]]}}, "table_mul": {"occupations": {"sector:manufacture": 1.3, "sector:farm": 1.5, "sector:health": 1.1}}},
  "rust_belt": {"override": {"age": {"bands": [[0, 5, 8], [6, 17, 22], [18, 29, 16], [30, 44, 18], [45, 64, 24], [65, 84, 11], [85, 99, 1]]}}, "table_mul": {"occupations": {"sector:health": 1.3, "sector:food": 1.2, "unemployed": 2.5, "sector:office": 0.6}}},
  "exurban": {"override": {"age": {"bands": [[0, 5, 5], [6, 17, 20], [18, 29, 9], [30, 44, 18], [45, 64, 31], [65, 84, 15], [85, 99, 2]]}}, "table_mul": {"occupations": {"sector:office": 1.8, "sector:health": 1.3, "doctor": 3.0, "factory_hand": 0.5, "unemployed": 0.4}}},
  "county_seat": {"override": {"age": {"bands": [[0, 5, 6], [6, 17, 16], [18, 29, 14], [30, 44, 18], [45, 64, 26], [65, 84, 17], [85, 99, 3]]}}, "table_mul": {"occupations": {"sector:public": 2.0, "sector:office": 1.5}}},
  "college_town": {"override": {"age": {"bands": [[0, 5, 4], [6, 17, 10], [18, 29, 38], [30, 44, 16], [45, 64, 18], [65, 84, 12], [85, 99, 2]]}}, "table_mul": {"occupations": {"university_student": 40, "sector:school": 1.8, "sector:food": 1.4}}},
  "lake_resort": {"override": {"age": {"bands": [[0, 5, 3], [6, 17, 10], [18, 29, 9], [30, 44, 12], [45, 64, 32], [65, 84, 30], [85, 99, 4]]}}, "table_mul": {"occupations": {"sector:food": 2.0, "sector:retail": 1.5, "fisher": 2.5, "sector:manufacture": 0.4}}}
 },

 "traits": [
  {"id": "sex", "layer": "L0", "group": "identity", "type": "pick",
   "choose": {"weights": {"female": 51, "male": 49}},
   "affects": ["body.shape", "face", "hair.style", "outfit", "voice", "name"], "inherit": "none"},

  {"id": "age", "layer": "L0", "group": "identity", "type": "int", "range": [0, 99],
   "choose": {"bands": [[0, 5, 6], [6, 17, 16], [18, 29, 13], [30, 44, 17], [45, 64, 27], [65, 84, 18], [85, 99, 3]]},
   "note": "Bands are the Stable Town archetype (_demographic_archetypes.md 1); a town's archetype replaces them.",
   "affects": ["body", "face.wrinkles", "hair.grey", "posture", "gait", "occupation", "outfit"]},

  {"id": "life_stage", "layer": "L0", "group": "identity", "type": "pick",
   "values": ["child", "teen", "young_adult", "adult", "elder"],
   "choose": {"derive": "iff(age < 13, 'child', iff(age < 18, 'teen', iff(age < 30, 'young_adult', iff(age < 65, 'adult', 'elder'))))"},
   "depends_on": ["age"], "affects": ["everything that reads it"]},

  {"id": "occupation", "layer": "L0", "group": "role", "type": "pick",
   "choose": {"table": "occupations", "weight_col": "weight", "where": "row.age_min <= age and age <= row.age_max"},
   "depends_on": ["age"], "affects": ["outfit", "props", "idles", "schedule", "income", "posture", "caricature", "dialogue"]},

  {"id": "income", "layer": "L0", "group": "role", "type": "pick",
   "values": ["none", "low", "mid", "high"],
   "choose": {"derive": "table('occupations', occupation, 'income')"},
   "depends_on": ["occupation"], "affects": ["outfit.quality", "outfit.wear", "housing"]},

  {"id": "wage", "layer": "L0", "group": "role", "type": "float", "unit": "USD/year",
   "choose": {"derive": "table('occupations', occupation, 'wage') * exp(rand_normal(0.0, 0.3)) * iff(age < 25, 0.75, iff(age < 35, 0.95, iff(age < 55, 1.1, 1.0)))"},
   "note": "Annual income from work, pension or benefits: the occupation's median (approx. BLS OEWS 2024) x lognormal spread x experience. research/lives/02_money.md",
   "depends_on": ["occupation", "age"], "affects": ["outfit.quality", "housing", "spending", "dialogue"]},

  {"id": "given_name", "layer": "L0", "group": "identity", "type": "text",
   "choose": {"derive": "''"},
   "note": "From the game bible (NpcNames.given): pinned per person by NpcHouseholds from the birth cohort's name pools and the family's heritage.",
   "affects": ["dialogue", "name", "lineage"]},

  {"id": "surname", "layer": "L0", "group": "identity", "type": "text",
   "choose": {"derive": "''"},
   "note": "From the game bible (NpcNames.surname): the household's surname line, pinned by NpcHouseholds (Charter art. 9: either parent's).",
   "affects": ["dialogue", "name", "lineage"]},

  {"id": "lineage", "layer": "L0", "group": "identity", "type": "text",
   "choose": {"derive": "''"},
   "note": "The great-family lineage of the surname (research/bible/05_lineages.md), '' for most people; pinned by NpcHouseholds.",
   "affects": ["dialogue", "name", "lineage"]},

  {"id": "name_heritage", "layer": "L0", "group": "identity", "type": "text",
   "choose": {"derive": "''"},
   "note": "The surname's heritage label (names.json); shades given names and lineage lore; pinned by NpcHouseholds.",
   "affects": ["dialogue", "name", "lineage"]},

  {"id": "height", "layer": "L1", "group": "body", "type": "float", "range": [0.8, 2.1], "unit": "m",
   "choose": {"normal": [1.63, 0.07], "clamp": [1.4, 1.95]},
   "mods": [{"if": "sex == 'male'", "add": 0.13},
            {"if": "age < 18", "mul": "0.52 + 0.48 * min(1, age / 17)"},
            {"if": "age > 70", "add": -0.03}],
   "depends_on": ["sex", "age"], "affects": ["shape:height", "gait.stride", "describe"], "describe": [[1.55, "short"], [1.8, "average height"], [9, "tall"]], "inherit": "blend"},

  {"id": "build", "layer": "L1", "group": "body", "type": "vec3",
   "choose": {"dirichlet": [3.0, 2.0, 2.2]},
   "mods": [{"if": "occupation in ['builder', 'dock_worker', 'farmer', 'fisher', 'mechanic']", "bias": [0, 1.5, 0]},
            {"if": "age > 45", "bias": [0, 0, 1.0]},
            {"if": "age < 13", "bias": [1.5, 0, 0]}],
   "note": "Body triangle: barycentric (thin, muscular, heavy), sums to 1",
   "depends_on": ["occupation", "age"], "affects": ["shape:thin", "shape:muscular", "shape:heavy", "gait", "outfit.fit"], "inherit": "blend"},

  {"id": "weight", "layer": "L1", "group": "body", "type": "float", "unit": "kg",
   "choose": {"derive": "22.0 * height * height * (0.85 + 0.15 * build[1] + 0.55 * build[2])"},
   "depends_on": ["height", "build"], "affects": ["gait.bounce", "describe", "physics.mass"]},

  {"id": "proportions", "layer": "L1", "group": "body", "type": "vec4",
   "choose": {"normal": [0, 0.35], "clamp": [-1, 1]},
   "note": "leg length, shoulder width, hip width, head size: each -1..1 around the stylised mean",
   "depends_on": [], "affects": ["shape:legs", "shape:shoulders", "shape:hips", "shape:head"], "inherit": "blend"},

  {"id": "posture", "layer": "L1", "group": "body", "type": "float", "range": [-1, 1],
   "choose": {"normal": [0.2, 0.3], "clamp": [-1, 1]},
   "mods": [{"if": "age > 65", "add": "-0.02 * (age - 65)"},
            {"if": "occupation in ['police', 'teacher', 'pastor']", "add": 0.25}],
   "note": "-1 stooped .. 1 upright",
   "depends_on": ["age", "occupation"], "affects": ["anim:spine", "gait.lean"]},

  {"id": "mobility_aid", "layer": "L1", "group": "body", "type": "pick",
   "values": ["none", "cane", "walker", "wheelchair"],
   "choose": {"weights": {"none": 97, "cane": 2, "walker": 0.5, "wheelchair": 0.5}},
   "mods": [{"if": "age > 75", "weights": {"none": 70, "cane": 20, "walker": 7, "wheelchair": 3}}],
   "depends_on": ["age"], "affects": ["props", "gait", "navigation"]},

  {"id": "skin", "layer": "L1", "group": "colour", "type": "color2d",
   "choose": {"uniform2": [[0.0, 1.0], [0.2, 0.8]]},
   "note": "A point in the skin ramp (x: light-dark, y: cool-warm undertone), as CK3 colour genes. Shade colour derived warm.",
   "affects": ["shader:skin", "shader:skin_shade", "shader:blush"], "inherit": "blend"},

  {"id": "hair_colour", "layer": "L1", "group": "colour", "type": "color2d",
   "choose": {"uniform2": [[0.0, 1.0], [0.0, 1.0]], "bias_x": 2.2},
   "note": "x: dark-light, y: ash-red. Mostly dark; greys with age via hair_grey.",
   "affects": ["shader:hair"], "inherit": "blend"},

  {"id": "hair_grey", "layer": "L1", "group": "colour", "type": "float", "range": [0, 1],
   "choose": {"derive": "clamp((age - 35 + rand_normal(0, 8)) / 35, 0, 1)"},
   "depends_on": ["age"], "affects": ["shader:hair"]},

  {"id": "eye_colour", "layer": "L1", "group": "colour", "type": "color2d",
   "choose": {"uniform2": [[0.0, 1.0], [0.0, 1.0]], "bias_x": 1.8},
   "affects": ["shader:eyes"], "inherit": "pick"},

  {"id": "hair_style", "layer": "L1", "group": "hair", "type": "pick",
   "values": ["crop", "short_side_part", "bob", "shoulder", "long_loose", "ponytail", "braids", "bun", "curly_short", "curly_long", "balding", "bald", "tied_scarf"],
   "choose": {"weights": {"crop": 12, "short_side_part": 12, "bob": 10, "shoulder": 10, "long_loose": 6, "ponytail": 10, "braids": 4, "bun": 8, "curly_short": 8, "curly_long": 5, "balding": 5, "bald": 3, "tied_scarf": 2}},
   "mods": [{"if": "sex == 'male'", "weights": {"crop": 30, "short_side_part": 30, "curly_short": 12, "ponytail": 2, "shoulder": 3, "balding": 12, "bald": 6}},
            {"if": "sex == 'male' and age < 25", "reweight": {"balding": 0, "bald": 0.5}},
            {"if": "sex == 'female' and age > 60", "weights": {"bun": 30, "bob": 25, "curly_short": 20, "short_side_part": 10, "tied_scarf": 5}}],
   "depends_on": ["sex", "age"], "affects": ["mesh:hair", "silhouette"]},

  {"id": "face", "layer": "L1", "group": "face", "type": "vec8",
   "choose": {"normal": [0, 0.4], "clamp": [-1, 1]},
   "note": "face width, jaw, chin, cheek, nose size, eye size, eye spacing, mouth width: each -1..1. Scaled by caricature.",
   "affects": ["shape:face_*"], "inherit": "blend"},

  {"id": "brow", "layer": "L1", "group": "face", "type": "pick",
   "values": ["thin", "straight", "arched", "heavy", "bushy", "sparse"],
   "choose": {"weights": {"thin": 15, "straight": 25, "arched": 20, "heavy": 20, "bushy": 10, "sparse": 10}},
   "mods": [{"if": "age > 60 and sex == 'male'", "weights": {"straight": 10, "bushy": 40, "heavy": 30, "sparse": 20}}],
   "depends_on": ["sex", "age"], "affects": ["shader:face.brow"], "inherit": "pick"},

  {"id": "caricature", "layer": "L1", "group": "face", "type": "float", "range": [0, 1],
   "choose": {"beta": [2.0, 6.0]},
   "mods": [{"add": "table('occupations', occupation, 'caricature') - 0.25"},
            {"if": "age > 60", "add": 0.15}],
   "note": "How far face and proportions depart from the mean (ghibli_style.md 1.3).",
   "depends_on": ["occupation", "age"], "affects": ["shape:face_*", "shape:head"]},

  {"id": "facial_hair", "layer": "L1", "group": "face", "type": "pick",
   "values": ["none", "stubble", "moustache", "short_beard", "full_beard"],
   "choose": {"weights": {"none": 1}},
   "mods": [{"if": "sex == 'male' and age >= 18", "weights": {"none": 45, "stubble": 20, "moustache": 12, "short_beard": 13, "full_beard": 10}}],
   "depends_on": ["sex", "age"], "affects": ["shader:face", "mesh:beard"]},

  {"id": "face_marks", "layer": "L1", "group": "face", "type": "tags",
   "values": ["freckles", "mole", "scar", "crows_feet", "laugh_lines", "sun_weathered", "glasses"],
   "choose": {"each": {"freckles": 0.12, "mole": 0.1, "scar": 0.03, "glasses": 0.18, "crows_feet": "iff(age > 55, 0.9, 0.0)", "laugh_lines": "iff(age > 45, 0.7, 0.0)", "sun_weathered": "iff(occupation in ['fisher', 'farmer', 'builder', 'dock_worker'], 0.7, 0.05)"}},
   "depends_on": ["age", "occupation"], "affects": ["shader:face", "mesh:glasses", "describe"]},

  {"id": "style", "layer": "L1", "group": "clothing", "type": "pick",
   "values": ["plain", "tidy", "practical", "worn", "old_fashioned", "flamboyant", "sporty"],
   "choose": {"weights": {"plain": 30, "tidy": 18, "practical": 20, "worn": 12, "old_fashioned": 8, "flamboyant": 4, "sporty": 8}},
   "mods": [{"if": "age > 65", "weights": {"old_fashioned": 40, "tidy": 25, "plain": 25}},
            {"if": "income == 'low'", "reweight": {"worn": 25}}],
   "depends_on": ["age", "income"], "affects": ["outfit.templates", "outfit.fabric", "outfit.wear"]},

  {"id": "palette", "layer": "L1", "group": "clothing", "type": "pick",
   "choose": {"weights": {"earth": 30, "sea": 20, "meadow": 15, "dusk": 12, "work": 23}},
   "mods": [{"if": "style == 'flamboyant'", "reweight": {"dusk": 40, "meadow": 30}}],
   "depends_on": ["style"], "affects": ["outfit.colours"]},

  {"id": "accent_colour", "layer": "L1", "group": "clothing", "type": "int", "range": [-1, 4],
   "choose": {"weights": {"-1": 60, "0": 8, "1": 8, "2": 8, "3": 8, "4": 8}},
   "mods": [{"if": "age < 13", "reweight": {"-1": 20}}],
   "note": "-1: none; else an index into the accent palette, for one item (ghibli_style.md 2.2 rule 1).",
   "depends_on": ["age"], "affects": ["outfit.accent"]},

  {"id": "wear", "layer": "L1", "group": "clothing", "type": "float", "range": [0, 1],
   "choose": {"beta": [2, 4]},
   "mods": [{"if": "income in ['none', 'low']", "add": 0.15},
            {"if": "style == 'worn'", "add": 0.3},
            {"if": "style == 'tidy'", "add": -0.15}],
   "depends_on": ["income", "style"], "affects": ["shader:fabric.fade", "shader:fabric.patches"]},

  {"id": "accessories", "layer": "L1", "group": "clothing", "type": "tags",
   "values": ["hat", "cap", "scarf", "bag", "basket", "watch", "necklace", "earrings", "headscarf", "hairband"],
   "choose": {"each": {"hat": "iff(age > 50, 0.25, 0.08)", "cap": 0.12, "scarf": 0.1, "bag": 0.25, "basket": 0.04, "watch": 0.3, "necklace": 0.12, "earrings": "iff(sex == 'female', 0.35, 0.03)", "headscarf": 0.03, "hairband": "iff(age < 18, 0.2, 0.03)"}},
   "depends_on": ["age", "sex"], "affects": ["mesh:accessory", "outfit.accent"]},

  {"id": "gait", "layer": "L1", "group": "motion", "type": "vec4",
   "choose": {"normal": [1.0, 0.08], "clamp": [0.7, 1.3]},
   "mods": [{"if": "age > 65", "mul": [0.85, 0.9, 0.7, 0.7]},
            {"if": "age < 13", "mul": [0.9, 1.25, 1.3, 1.2]}],
   "note": "stride scale, cadence scale, bounce, arm swing: each around 1.0",
   "depends_on": ["age", "build", "posture"], "affects": ["anim:walk", "anim:run"]},

  {"id": "voice", "layer": "L1", "group": "motion", "type": "vec3",
   "choose": {"normal": [0, 0.3], "clamp": [-1, 1]},
   "note": "pitch, rate, roughness (for TTS or barks)",
   "depends_on": ["sex", "age"], "affects": ["audio:voice"]},

  {"id": "car_access", "layer": "L1", "group": "life", "type": "pick",
   "values": ["own_car", "shared_car", "none"],
   "choose": {"weights": {"own_car": 80, "shared_car": 12, "none": 8}},
   "mods": [{"if": "age < 16", "weights": {"none": 1}},
            {"if": "age > 15 and age < 18", "weights": {"own_car": 15, "shared_car": 45, "none": 40}},
            {"if": "age > 17 and wage < 25000.0", "reweight": {"none": 25, "shared_car": 20}},
            {"if": "age > 84", "reweight": {"none": 45}},
            {"if": "mobility_aid == 'wheelchair'", "reweight": {"none": 40}}],
   "note": "Vehicle access (ACS: about 8% of US households have no vehicle; approx.). research/lives/04_travel.md",
   "depends_on": ["age", "wage", "mobility_aid"], "affects": ["travel", "schedule", "spending"]},

  {"id": "commute_mode", "layer": "L1", "group": "life", "type": "pick",
   "values": ["drive", "carpool", "transit", "walk", "bike", "remote", "school_bus", "none", "driven"],
   "choose": {"weights": {"drive": 69, "carpool": 9, "transit": 3, "walk": 2.5, "bike": 0.6, "remote": 14}},
   "mods": [{"if": "not (occupation in ['clerk', 'agent', 'editor', 'banker', 'lawyer', 'librarian'])", "reweight": {"remote": 0}},
            {"if": "car_access == 'none'", "weights": {"transit": 45, "walk": 30, "bike": 15, "carpool": 10}},
            {"if": "car_access == 'shared_car'", "reweight": {"drive": 35, "carpool": 25, "transit": 8}},
            {"if": "occupation == 'student'", "weights": {"school_bus": 45, "carpool": 25, "walk": 20, "bike": 10}},
            {"if": "occupation == 'preschool'", "weights": {"driven": 70, "walk": 30}},
            {"if": "occupation == 'university_student'", "weights": {"transit": 30, "bike": 25, "walk": 25, "drive": 20}},
            {"if": "occupation in ['retired', 'homemaker', 'unemployed']", "weights": {"none": 1}},
            {"if": "occupation in ['farmer', 'farmhand'] or mobility_aid == 'wheelchair'", "reweight": {"walk": 0, "bike": 0}}],
   "note": "How they usually get to work or school (ACS 2023 approx.: drive alone ~69%, carpool ~9%, transit ~3%, walk ~2.5%, bike ~0.6%, work from home ~14%). Short trips may still be walked (NpcLife).",
   "depends_on": ["occupation", "car_access", "mobility_aid"], "affects": ["travel", "schedule"]},

  {"id": "personality", "layer": "L2", "group": "mind", "type": "map",
   "keys": ["openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism", "warmth", "humour", "courage", "honesty", "curiosity"],
   "choose": {"normal": [0.5, 0.17], "clamp": [0, 1]},
   "note": "Big Five plus facets that matter in dialogue. Mid-weighted, as in Dwarf Fortress: most people ordinary, few extreme.",
   "affects": ["dialogue", "idles.gesture_amount", "schedule.jitter", "reactions"], "inherit": "blend"},

  {"id": "speech", "layer": "L2", "group": "mind", "type": "map",
   "keys": ["formality", "verbosity", "dialect"],
   "choose": {"normal": [0.5, 0.2], "clamp": [0, 1]},
   "mods": [{"add": {"verbosity": "0.3 * (personality.extraversion - 0.5)"}}],
   "depends_on": ["personality", "age", "occupation"], "affects": ["dialogue"]},

  {"id": "preferences", "layer": "L2", "group": "mind", "type": "map",
   "keys": ["food", "colour", "place", "pastime"],
   "choose": {"from_lists": true},
   "note": "Lists come in the literary phase. The favourite colour feeds back into accessory colour by rule, not by dependency.",
   "affects": ["dialogue", "gifts", "schedule.leisure"]},

  {"id": "backstory", "layer": "L2", "group": "history", "type": "map",
   "keys": ["childhood", "adulthood"],
   "choose": {"from_lists": true},
   "note": "RimWorld-style bundles (skills, work limits, a forced trait or two), filtered by occupation and age. Written in the literary phase.",
   "depends_on": ["occupation", "age"], "affects": ["skills", "dialogue", "knowledge"]},

  {"id": "money_style", "layer": "L2", "group": "money", "type": "pick",
   "values": ["saver", "careful", "spender", "generous", "tight", "anxious"],
   "choose": {"derive": "iff(personality.conscientiousness > 0.64, 'saver', iff(personality.conscientiousness < 0.36, 'spender', iff(personality.agreeableness > 0.66, 'generous', iff(personality.agreeableness < 0.34, 'tight', iff(personality.neuroticism > 0.66, 'anxious', 'careful')))))"},
   "note": "How they handle money, from personality.",
   "depends_on": ["personality"], "affects": ["savings", "debt", "dialogue", "reactions"]},

  {"id": "savings", "layer": "L2", "group": "money", "type": "float", "unit": "USD",
   "choose": {"derive": "max(0.0, wage * (0.15 + max(0.0, age - 22.0) / 30.0) * iff(money_style == 'saver', 1.8, iff(money_style == 'spender', 0.3, iff(money_style == 'tight', 1.5, iff(money_style == 'generous', 0.7, iff(money_style == 'anxious', 1.2, 1.0))))) * exp(rand_normal(-1.6, 2.5)))"},
   "note": "Liquid savings and investments (not the house). Heavy left tail: many have almost nothing (Fed SHED 2023: 63% could cover $400 in cash).",
   "depends_on": ["wage", "age", "money_style"], "affects": ["finances", "dialogue"]},

  {"id": "debt", "layer": "L2", "group": "money", "type": "float", "unit": "USD",
   "choose": {"derive": "max(0.0, wage * exp(rand_normal(-2.1, 1.3)) * iff(money_style == 'spender', 2.0, iff(money_style == 'saver', 0.4, 1.0)) * iff(age < 22, 0.2, 1.0))"},
   "note": "Consumer and personal debt (not a mortgage).",
   "depends_on": ["wage", "money_style", "age"], "affects": ["finances", "stress", "dialogue"]},

  {"id": "debts", "layer": "L2", "group": "money", "type": "tags",
   "values": ["mortgage", "student_loans", "medical", "credit_card", "car_loan", "payday_loan", "gambling", "family_loan", "child_support"],
   "choose": {"each": {"mortgage": "iff(age > 27 and age < 66, 0.4, 0.03)", "student_loans": "iff(age > 21 and age < 46, iff(occupation in ['teacher', 'nurse', 'lawyer', 'doctor', 'pharmacist', 'dentist', 'librarian', 'editor', 'banker'], 0.55, 0.15), 0.0)", "medical": "iff(age > 17, iff(mobility_aid != 'none', 0.35, iff(age > 60, 0.15, 0.08)), 0.0)", "credit_card": "iff(age > 19, iff(money_style == 'spender', 0.65, 0.3), 0.0)", "car_loan": "iff(age > 19 and age < 70, 0.28, 0.0)", "payday_loan": "iff(age > 19, iff(wage < 35000.0, 0.09, 0.01), 0.0)", "gambling": "iff('gambling' in addictions, 0.6, 0.0)", "family_loan": "iff(age > 19, 0.06, 0.0)", "child_support": "iff(age > 24 and age < 60, 0.04, 0.0)"}},
   "depends_on": ["age", "occupation", "mobility_aid", "money_style", "wage", "addictions"], "affects": ["dialogue", "stress", "stories"]},

  {"id": "money_reasons", "layer": "L2", "group": "money", "type": "tags",
   "values": ["inherited", "windfall", "two_jobs", "laid_off", "pension", "benefits", "family_money", "owns_business", "sends_money_home", "supports_parent", "medical_bills", "gambling_losses", "divorce", "raising_kids_alone", "frugal"],
   "choose": {"each": {"inherited": "iff(age > 40, 0.08, 0.02)", "windfall": 0.015, "two_jobs": "iff(age > 17 and age < 66, iff(wage < 40000.0, 0.14, 0.03), 0.0)", "laid_off": "iff(occupation == 'unemployed', 0.8, iff(age > 20 and age < 65, 0.04, 0.0))", "pension": "iff(occupation == 'retired', 0.65, 0.0)", "benefits": "iff(occupation == 'unemployed' or mobility_aid != 'none', 0.5, 0.0)", "family_money": 0.035, "owns_business": "iff(occupation in ['shopkeeper', 'farmer', 'barber', 'lawyer', 'dentist', 'fisher', 'baker'], 0.6, 0.02)", "sends_money_home": "iff(age > 20 and age < 60, 0.05, 0.0)", "supports_parent": "iff(age > 30 and age < 65, 0.08, 0.0)", "medical_bills": "iff('medical' in debts, 0.8, 0.02)", "gambling_losses": "iff('gambling' in addictions, 0.75, 0.0)", "divorce": "iff(age > 28, 0.06, 0.0)", "raising_kids_alone": "iff(age > 20 and age < 55, 0.05, 0.0)", "frugal": "iff(money_style == 'saver' or money_style == 'tight', 0.5, 0.05)"}},
   "note": "Why they have what they have: dialogue material.",
   "depends_on": ["age", "occupation", "wage", "mobility_aid", "debts", "addictions", "money_style"], "affects": ["dialogue", "stories"]},

  {"id": "finances", "layer": "L2", "group": "money", "type": "pick",
   "values": ["dependent", "wealthy", "comfortable", "getting_by", "struggling", "in_debt"],
   "choose": {"derive": "iff(age < 18, 'dependent', iff(savings - debt > 400000.0, 'wealthy', iff(savings - debt > max(20000.0, wage * 0.5), 'comfortable', iff(savings - debt > -0.06 * max(wage, 10000.0), 'getting_by', iff(debt > max(wage, 8000.0), 'in_debt', 'struggling')))))"},
   "note": "The situation in a word (Fed SHED 2023: 72% at least okay).",
   "depends_on": ["savings", "debt", "wage", "age"], "affects": ["dialogue", "stress", "outfit.wear", "stories"]},

  {"id": "addictions", "layer": "L2", "group": "health", "type": "tags",
   "values": ["alcohol", "nicotine", "cannabis", "opioids", "stimulants", "sedatives", "gambling", "social_media", "gaming", "shopping", "food", "caffeine", "work"],
   "choose": {"each": {"alcohol": "iff(age > 15, 0.11 * iff(sex == 'male', 1.4, 0.7) * iff(age < 30, 1.3, iff(age > 64, 0.6, 1.0)) * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)) * iff(occupation in ['bartender', 'fisher', 'dock_worker', 'waiter', 'cook'], 1.6, 1.0), 0.0)", "nicotine": "iff(age > 13, 0.17 * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)) * iff(occupation in ['builder', 'dock_worker', 'fisher', 'factory_hand', 'farmhand', 'driver'], 1.5, 1.0), 0.0)", "cannabis": "iff(age > 14, 0.07 * iff(age < 30, 1.7, iff(age > 55, 0.4, 1.0)) * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)) * (0.7 + 0.6 * personality.openness), 0.0)", "opioids": "iff(age > 17, 0.018 * iff(mobility_aid != 'none', 2.5, 1.0) * iff(occupation in ['builder', 'dock_worker', 'fisher', 'factory_hand', 'farmhand', 'mechanic'], 1.6, 1.0) * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)), 0.0)", "stimulants": "iff(age > 16, 0.012 * iff(age < 40, 1.6, 0.4) * iff(occupation in ['driver', 'hotel_worker', 'nurse', 'bartender'], 1.5, 1.0) * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)), 0.0)", "sedatives": "iff(age > 17, 0.015 * iff(sex == 'male', 0.7, 1.4) * iff(age > 50, 1.6, 1.0) * (0.5 + personality.neuroticism), 0.0)", "gambling": "iff(age > 17, 0.024 * iff(sex == 'male', 1.5, 0.6) * iff(age < 30, 1.6, 1.0) * iff(wage < 35000.0, 1.3, 1.0) * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)), 0.0)", "social_media": "0.07 * iff(age < 13, 0.3, iff(age < 20, 3.2, iff(age < 30, 2.0, iff(age > 60, 0.3, 1.0)))) * iff(sex == 'male', 0.8, 1.25) * (0.6 + 0.8 * personality.neuroticism)", "gaming": "iff(age > 7, 0.02 * iff(age < 20, 3.0, iff(age < 35, 1.5, 0.4)) * iff(sex == 'male', 1.8, 0.6) * (1.4 - 0.8 * personality.conscientiousness), 0.0)", "shopping": "iff(age > 16, 0.035 * iff(sex == 'male', 0.25, 1.7) * ((0.6 + 0.8 * personality.neuroticism) * (1.4 - 0.8 * personality.conscientiousness)), 0.0)", "food": "iff(age > 12, 0.028 * (0.6 + 0.8 * personality.neuroticism), 0.0)", "caffeine": "iff(age > 17, 0.09 * iff(occupation in ['nurse', 'doctor', 'driver', 'police', 'editor', 'hotel_worker'], 1.6, 1.0), 0.0)", "work": "iff(age > 20 and age < 70 and not (occupation in ['retired', 'unemployed', 'student', 'homemaker']), 0.05 * (0.4 + 1.2 * personality.conscientiousness) * (0.6 + 0.8 * personality.neuroticism), 0.0)"}},
   "note": "Kinds they have struggled with (any stage). Rates: research/lives/03_addiction.md. Depicted as behaviour, never as a label; recovery is common.",
   "depends_on": ["age", "sex", "occupation", "mobility_aid", "wage", "personality"], "affects": ["schedule", "money", "stress", "dialogue", "stories"]},

  {"id": "addiction_stage", "layer": "L2", "group": "health", "type": "pick",
   "values": ["none", "at_risk", "active", "recovering", "relapsed"],
   "choose": {"weights": {"none": 1}},
   "mods": [{"if": "addictions != []", "weights": {"at_risk": 30, "active": 35, "recovering": 28, "relapsed": 7}}],
   "note": "Where they are with their main (first-listed) addiction.",
   "depends_on": ["addictions"], "affects": ["schedule", "dialogue", "stories"]},

  {"id": "addiction_severity", "layer": "L2", "group": "health", "type": "float",
   "choose": {"beta": [2.0, 3.0]},
   "mods": [{"if": "addictions == []", "mul": 0.0}],
   "note": "0..1 for the main addiction: how much it shapes their days.",
   "depends_on": ["addictions"], "affects": ["schedule", "money", "dialogue"]},

  {"id": "worship", "layer": "L2", "group": "life", "type": "pick",
   "values": ["weekly", "monthly", "seldom", "never"],
   "choose": {"weights": {"weekly": 30, "monthly": 11, "seldom": 26, "never": 33}},
   "mods": [{"if": "age >= 65", "reweight": {"weekly": 38, "never": 25}},
            {"if": "age >= 18 and age < 30", "reweight": {"weekly": 21, "never": 40}},
            {"if": "occupation == 'pastor'", "weights": {"weekly": 1}}],
   "note": "Religious service attendance (Gallup 2021-23: 21% weekly + 9% almost weekly, 11% monthly, 26% seldom, 31% never; older adults attend more). NpcLife sends weekly and monthly attenders to a church.",
   "depends_on": ["age", "occupation"], "affects": ["schedule", "ties", "dialogue"]},

  {"id": "schedule", "layer": "L3", "group": "life", "type": "rule",
   "choose": {"rule": "schedule_template", "args": ["table:occupations.hours", "personality", "household"]},
   "note": "A pure function of time: where(person, t). See procedural_npcs.md 2.4.",
   "depends_on": ["occupation", "personality"], "affects": ["placement"]},

  {"id": "relationships", "layer": "L3", "group": "life", "type": "rule",
   "choose": {"rule": "relationships", "note": "household members, plus deterministic friends and rivals among nearby residents"},
   "affects": ["dialogue", "knowledge", "quests"]},

  {"id": "self_control", "layer": "L2", "group": "conduct", "type": "float",
   "choose": {"derive": "clamp(0.12 + 0.5 * personality.conscientiousness + 0.15 * personality.agreeableness + 0.15 * (1.0 - personality.neuroticism) + 0.004 * min(40.0, max(0.0, age - 16.0)) + iff(sex == 'male', -0.05, 0.0) + rand_normal(0.0, 0.08), 0.0, 1.0)"},
   "note": "Gottfredson & Hirschi's self-control: mostly conscientiousness, with agreeableness and calm; it grows through the twenties and thirties; men a little lower (research/traffic/03).",
   "depends_on": ["personality", "age", "sex"], "affects": ["deviance", "dialogue", "reactions"]},

  {"id": "sensation_seeking", "layer": "L2", "group": "conduct", "type": "float",
   "choose": {"derive": "clamp(0.5 + 0.3 * (personality.openness - 0.5) + 0.25 * (personality.extraversion - 0.5) + iff(sex == 'male', 0.08, -0.06) - 0.009 * (min(80.0, max(14.0, age)) - 30.0) + rand_normal(0.0, 0.12), 0.0, 1.0)"},
   "note": "Zuckerman's sensation seeking: higher in men, declining steeply with age (Ball et al. 1984); r = 0.30-0.40 with risky driving (Jonah 1997).",
   "depends_on": ["personality", "age", "sex"], "affects": ["deviance", "driving", "preferences"]},

  {"id": "driving_anger", "layer": "L2", "group": "conduct", "type": "float",
   "choose": {"derive": "clamp(0.35 + 0.35 * (personality.neuroticism - 0.5) - 0.3 * (personality.agreeableness - 0.5) - 0.004 * (min(80.0, max(16.0, age)) - 30.0) + rand_normal(0.0, 0.1), 0.0, 1.0)"},
   "note": "Deffenbacher's driving anger: neuroticism and low agreeableness; among men it falls with age (Lajunen & Parker 2001).",
   "depends_on": ["personality", "age"], "affects": ["deviance", "driving", "reactions"]},

  {"id": "deviance", "layer": "L2", "group": "conduct", "type": "float",
   "choose": {"derive": "clamp(0.62 * (1.0 - self_control) + 0.25 * sensation_seeking + 0.15 * driving_anger + 0.12 * (0.5 - personality.honesty) - 0.2 + rand_normal(0.0, 0.05), 0.0, 1.0)"},
   "note": "The common factor behind risky driving and crime (Junger, West & Timman 2001): low self-control, sensation seeking, anger, low honesty. Drives every drive_* trait and the record.",
   "depends_on": ["self_control", "sensation_seeking", "driving_anger", "personality"], "affects": ["drive_*", "record", "dialogue"]},

  {"id": "drive_speeding", "layer": "L2", "group": "driving", "type": "float",
   "choose": {"derive": "clamp(0.83 * (0.065 + 0.3 * (deviance - 0.17) + 0.1 * (sensation_seeking - 0.45)) + rand_normal(0.0, 0.065), -0.06, 0.4)"},
   "note": "Habitual speed above the posted limit (fraction). Calibrated so ~25% are speeders (>= +10%), ~40% sometime (+3..10%), ~35% at or under (NHTSA 2011: 30/40/30, x 0.83 for Ohio, NHTSA 2022); half of 16-20s are speeders, 15% of 65+.",
   "depends_on": ["deviance", "sensation_seeking"], "affects": ["NpcTraffic"]},

  {"id": "drive_full_stop", "layer": "L2", "group": "driving", "type": "float",
   "choose": {"derive": "clamp(0.27 - 1.3 * (deviance - 0.17) + rand_normal(0.0, 0.18), 0.02, 0.98)"},
   "note": "Chance of a complete stop at a stop sign with nobody about; ~0.27 on average (22.8 per 100 vehicles, DeVeauuse et al. 1999). People present raise it (53 per 100 with pedestrians).",
   "depends_on": ["deviance"], "affects": ["NpcTraffic"]},

  {"id": "drive_headway", "layer": "L2", "group": "driving", "type": "float", "unit": "s",
   "choose": {"derive": "clamp(1.45 - 0.9 * (driving_anger - 0.35) - 0.6 * (sensation_seeking - 0.45) + rand_normal(0.0, 0.38), 0.6, 3.0)"},
   "note": "Time gap kept to the vehicle ahead (ORC 4511.34); under 1 s is tailgating (~10%; estimate, research/traffic/02).",
   "depends_on": ["driving_anger", "sensation_seeking"], "affects": ["NpcTraffic"]},

  {"id": "drive_pass_right", "layer": "L2", "group": "driving", "type": "float",
   "choose": {"derive": "clamp(0.06 + 0.6 * max(0.0, deviance - 0.15) + 0.25 * max(0.0, driving_anger - 0.45) + rand_normal(0.0, 0.03), 0.0, 0.8)"},
   "note": "Chance, when held up behind a stopped vehicle, of passing it on the right where ORC 4511.28 forbids it (estimate: ~10% of chances).",
   "depends_on": ["deviance", "driving_anger"], "affects": ["NpcTraffic"]},

  {"id": "drive_red_light", "layer": "L2", "group": "driving", "type": "float",
   "choose": {"derive": "clamp(0.02 + 0.3 * max(0.0, deviance - 0.2) + 0.1 * max(0.0, sensation_seeking - 0.55) + rand_normal(0.0, 0.015), 0.0, 0.6)"},
   "note": "Chance of going on through a yellow it could stop for, or a fresh red (red-light runners: young, male, prior violations; Retting et al. 1999).",
   "depends_on": ["deviance", "sensation_seeking"], "affects": ["NpcTraffic"]},

  {"id": "drive_yield_peds", "layer": "L2", "group": "driving", "type": "float",
   "choose": {"derive": "clamp(0.53 - 1.0 * (deviance - 0.17) + rand_normal(0.0, 0.18), 0.05, 1.0)"},
   "note": "Chance of stopping for a person about to cross (ORC 4511.46); ~0.53 on average (53 per 100 vehicles stopped for pedestrians present, DeVeauuse et al. 1999). Nobody drives into a person in the road.",
   "depends_on": ["deviance"], "affects": ["NpcTraffic"]},

  {"id": "drive_cross_solid", "layer": "L2", "group": "driving", "type": "float",
   "choose": {"derive": "clamp(0.01 + 0.35 * max(0.0, deviance - 0.25) + 0.2 * max(0.0, driving_anger - 0.5) + rand_normal(0.0, 0.01), 0.0, 0.6)"},
   "note": "Chance of overtaking a slow vehicle across a double yellow line (ORC 4511.31) when held up.",
   "depends_on": ["deviance", "driving_anger"], "affects": ["NpcTraffic"]},

  {"id": "record", "layer": "L2", "group": "conduct", "type": "tags",
   "values": ["traffic_tickets", "felony", "violent", "property", "vandalism", "drug", "dui"],
   "choose": {"each": {"traffic_tickets": "iff(age > 16, min(0.9, 0.11 * exp(6.2 * (deviance - 0.17))), 0.0)", "felony": "iff(age > 17, min(0.9, 0.084 * exp(4.0 * (deviance - 0.17)) * min(1.0, (age - 17.0) / 15.0)), 0.0)", "violent": "iff(age > 15, min(0.8, 0.0258 * exp(4.3 * (deviance - 0.17)) * iff(sex == 'male', 1.6, 0.4)), 0.0)", "property": "iff(age > 13, min(0.8, 0.0487 * exp(1.85 * (deviance - 0.17))), 0.0)", "vandalism": "iff(age > 12, min(0.8, 0.0217 * exp(4.2 * (deviance - 0.17))), 0.0)", "drug": "iff(age > 15, min(0.8, 0.0351 * exp(4.0 * (deviance - 0.17)) * iff('cannabis' in addictions or 'opioids' in addictions or 'stimulants' in addictions, 2.5, 1.0)), 0.0)", "dui": "iff(age > 17, min(0.8, 0.0263 * exp(4.0 * (deviance - 0.17)) * iff('alcohol' in addictions, 3.0, 1.0)), 0.0)"}},
   "note": "What's on file. Base rates: felony 8% of adults (Shannon, Uggen & Schnittker 2017); traffic tickets in recent years ~17% (NHTSA 2011: 9% stopped a year, 68% ticketed). The others are estimates. Deviance scales the odds as Junger et al. (2001) found for risky drivers: traffic x5.3, violent x2.6, vandalism x2.5, property x1.5 (research/traffic/03).",
   "depends_on": ["deviance", "age", "sex", "addictions"], "affects": ["dialogue", "reactions", "story"]}
 ]
}
